{
	"name": "map-app",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.22.0"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"build": "pnpm --filter web build",
		"storybook": "pnpm --filter @thorbde/ui storybook",
		"build:storybook": "pnpm --filter @thorbde/ui build-storybook",
		"tokens": "pnpm --filter @thorbde/tokens build",
		"tokens:check": "pnpm --filter @thorbde/tokens check",
		"icons": "pnpm --filter @thorbde/icons build",
		"icons:check": "pnpm --filter @thorbde/icons check",
		"size": "pnpm --filter web size",
		"build:facts": "pnpm --filter web build:facts",
		"build:maps": "pnpm --filter web build:maps",
		"maps:check": "pnpm --filter web maps:check",
		"test": "pnpm --filter web test && pnpm --filter @thorbde/ui test && pnpm test:boundaries && pnpm test:scripts",
		"test:e2e": "pnpm --filter web test:e2e",
		"test:boundaries": "node --test \"tests/boundaries/*.test.mjs\"",
		"test:scripts": "node --test \"tests/scripts/*.test.mjs\"",
		"boundaries": "depcruise . --config .dependency-cruiser.cjs",
		"knip": "knip",
		"graph": "depcruise . --config .dependency-cruiser.cjs --output-type mermaid --collapse \"^(node_modules|apps/web/node_modules)/[^/]+\"",
		"typecheck": "pnpm -r typecheck",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "pnpm lint && pnpm typecheck && pnpm tokens:check && pnpm icons:check && pnpm maps:check && pnpm boundaries && pnpm knip && pnpm test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"dependency-cruiser": "18.7.2",
		"knip": "6.45.1"
	}
}
