{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignore": ["tests/boundaries/fixtures/**"],
	"workspaces": {
		".": {
			"entry": ["tests/boundaries/*.test.mjs", "tests/scripts/*.test.mjs"]
		},
		"apps/web": {
			"ignoreDependencies": ["world-atlas"]
		},
		"packages/tokens": {
			"entry": ["terrazzo.config.mjs"]
		},
		"packages/ui": {
			"ignoreDependencies": [
				"@fontsource/montserrat",
				"@fontsource/source-serif-4"
			]
		},
		"packages/icons": {
			"entry": ["scripts/build.mjs"]
		}
	}
}
