{
	"extends": "./tsconfig.json",
	"include": [
		"vite.config.ts",
		"vitest.config.ts",
		"react-router.config.ts",
		"playwright.config.ts",
		"tests/e2e/**/*",
		"scripts/**/*.ts",
		"scripts/fixtures/*.json",
		"app/features/countries/**/*",
		"app/features/maps/map-file.ts",
		"app/features/maps/outline-file.ts",
		"app/features/maps/outline-land.ts",
		"app/features/maps/equal-earth.ts",
		"app/features/maps/views.ts"
	],
	"compilerOptions": {
		"composite": true,
		"types": ["node", "vite/client"],
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true
	}
}
