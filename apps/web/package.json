{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "CLOUDFLARE_ENV=local react-router dev",
		"build": "react-router build",
		"preview": "pnpm build && vite preview",
		"typegen": "wrangler types && react-router typegen",
		"typecheck": "pnpm typegen && tsc -b",
		"build:facts": "node scripts/build-facts.ts",
		"size": "node scripts/check-bundle-size.mjs",
		"build:maps": "node scripts/build-maps.ts",
		"maps:check": "pnpm build:maps && git diff --exit-code -- app/features/maps/geometry",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --env local",
		"db:check": "drizzle-kit generate && git diff --exit-code -- app/server/db/migrations && test -z \"$(git ls-files --others --exclude-standard -- app/server/db/migrations)\""
	},
	"dependencies": {
		"@thorbde/icons": "workspace:*",
		"@thorbde/tokens": "workspace:*",
		"@thorbde/ui": "workspace:*",
		"better-auth": "1.7.28",
		"drizzle-orm": "0.45.4",
		"isbot": "5.2.3",
		"maplibre-gl": "6.18.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-router": "8.5.1",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.69.1",
		"@cloudflare/vitest-plugin": "1.8.2",
		"@playwright/test": "1.65.1",
		"@react-router/dev": "8.5.1",
		"@types/d3-geo": "3.1.1",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"d3-geo": "3.1.2",
		"drizzle-kit": "0.31.11",
		"mapshaper": "0.8.4",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.0",
		"wrangler": "4.162.0"
	}
}
