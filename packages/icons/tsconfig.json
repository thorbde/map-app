{
	"compilerOptions": {
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"lib": ["DOM", "ES2022"],
		"jsx": "react-jsx"
	},
	"include": ["src/**/*", "generated/**/*"]
}
